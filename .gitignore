# Rust / Soroban
/target
**/target
Cargo.lock.bak
*.wasm.d

# Node
node_modules
dist
.turbo
*.tsbuildinfo
.pnpm-store

# pnpm is the only installer for this workspace. A second root lockfile
# resolves a different dependency graph, so npm/yarn/bun lockfiles are never
# committed at the root (scripts/check-root-lockfile.mjs enforces the tracked set).
/package-lock.json
/yarn.lock
/bun.lock
/bun.lockb

# Env / secrets (NEVER commit live keys)
.env
.env.*
!.env.example
*.key
identities/

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# Build artifacts
/artifacts
/tmp-bindings
deployments/*.local.json

# Stellar CLI local identities/config (smoke keys live here — never commit)
.stellar

# Keeper
.keeper-store.json
.keeper-store.json.corrupted.*
.keeper-checkpoint.json
.keeper-checkpoint.json.corrupted.*

# Coverage
coverage/
*.lcov
*.lcov.info
lcov.info
.nyc_output/
