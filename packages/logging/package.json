{
  "name": "@sub-rosa/logging",
  "version": "0.1.0",
  "private": true,
  "description": "Structured JSON diagnostics with safe serialization and injectable sinks.",
  "main": "src/index.cjs",
  "types": "src/index.d.cts",
  "exports": {
    ".": {
      "types": "./src/index.d.cts",
      "default": "./src/index.cjs"
    },
    "./errors": {
      "types": "./src/errors.d.cts",
      "default": "./src/errors.cjs"
    }
  },
  "scripts": {
    "test": "node --test src/index.test.cjs src/errors.test.cjs"
  }
}
